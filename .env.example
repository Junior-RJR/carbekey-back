PORT=8080
# PostgreSQL (local, Neon, Supabase, Railway...)
DATABASE_URL=postgres://carbekey:carbekey@localhost:5432/carbekey
# Ative em bancos na nuvem que exigem SSL (Neon/Supabase)
DATABASE_SSL=false
# Segredo para assinar os tokens de login. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-isto
JWT_EXPIRES_IN=12h
# Chave de 32 bytes (64 caracteres hex) para criptografar as senhas salvas.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENÇÃO: se perder ou trocar esta chave, as senhas salvas não podem mais ser lidas.
ENCRYPTION_KEY=
# Origens do front liberadas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:3000
